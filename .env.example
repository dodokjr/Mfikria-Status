# ---------- Login ----------
# Rahasia penanda sesi, minimal 32 karakter. Buat dengan: openssl rand -base64 48
AUTH_SECRET=

# URL publik aplikasi, mis. https://status.contoh.com (dipakai untuk callback OAuth GitHub)
APP_URL=

# ---------- Google Spreadsheet (daftar user) ----------
# ID spreadsheet = bagian di URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
# Nama tab + rentang data (baris 1 = header).
# Kolom: email | password_hash | nama | role | aktif | github_login | github_id | terdaftar_pada
GOOGLE_SHEET_RANGE=users!A2:H
# Service account (Google Cloud > IAM > Service Accounts > Keys > JSON)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Isi dengan private_key dari JSON; newline boleh ditulis sebagai \n
GOOGLE_PRIVATE_KEY=

# ---------- Registrasi GitHub (OAuth App) ----------
# Buat di https://github.com/settings/developers > New OAuth App
# Authorization callback URL: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Opsional: username GitHub yang diundang (pisahkan koma). Jika diisi, hanya mereka yang bisa daftar dan akunnya langsung aktif.
GITHUB_ALLOWED_USERS=
# Jika GITHUB_ALLOWED_USERS kosong: false = akun baru nonaktif sampai admin mengubah kolom "aktif" jadi TRUE; true = langsung aktif
REGISTRATION_AUTO_APPROVE=false

# ---------- Status server ----------
# Nama project yang ditampilkan sebagai kartu utama (cocok dengan nama project Vercel/Netlify)
APP_NAME=mfikriaApp
# Opsional: URL health check langsung ke server mfikriaApp, mis. https://mfikriaapp.com/api/health
APP_HEALTH_URL=

# Token Vercel (boleh banyak, pisahkan koma) dan Team ID (kosong = akun personal)
VERCEL_TOKEN=
VERCEL_TEAM_IDS=
# Token Netlify (boleh banyak, pisahkan koma)
NETLIFY_TOKEN=

# ---------- Opsional ----------
CACHE_TTL=60            # detik
PING=true               # cek HTTP langsung ke URL tiap project/site
PING_TIMEOUT_MS=8000
